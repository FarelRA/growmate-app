# ── Convex ──────────────────────────────────────────────────────
# Public URL used by the browser to connect to Convex
NUXT_PUBLIC_CONVEX_URL=https://convex.growmate.bond

# Origin for Convex backend
CONVEX_CLOUD_ORIGIN=https://convex.growmate.bond
CONVEX_SITE_ORIGIN=https://convex.growmate.bond
CONVEX_SITE_URL=https://convex.growmate.bond
CONVEX_SELF_HOSTED_URL=https://convex.growmate.bond
CONVEX_INSTANCE_NAME=growmate

# Convex instance secret
#   INSTANCE_SECRET must be a hex string (generate: openssl rand -hex 32)
CONVEX_INSTANCE_SECRET=gm-convex-sec

# Admin key for deploying functions
#   Format: <INSTANCE_NAME>|<hex> (generated by backend via ./generate_admin_key.sh)
#   NOTE: Cannot be set arbitrarily - must be generated by the Convex backend
#         from INSTANCE_SECRET. Once generated, set it here to persist across restarts.
CONVEX_SELF_HOSTED_ADMIN_KEY=gm-convex-adm


# ── MinIO / S3 Storage ─────────────────────────────────────────
# MinIO S3-compatible endpoint
MINIO_ENDPOINT=http://minio:9000

# MinIO root credentials
MINIO_ACCESS_KEY=gm-minio-acc
MINIO_SECRET_KEY=gm-minio-sec

# Public URL for browser-accessible image URLs
NUXT_PUBLIC_MINIO_BASE_URL=https://storage.growmate.bond

# Bucket name for plant images
NUXT_PUBLIC_MINIO_BUCKET_IMAGE=images
MINIO_BUCKET_IMAGE=images

# ── OpenAI / AI ────────────────────────────────────────────────
# OpenAI-compatible gateway endpoint
OPENAI_BASE_URL=https://gateway.farel.at.eu.org/v1
# API key for the gateway
OPENAI_API_KEY=sk-bf-************************d32
# Model identifier (provider/model-name format)
OPENAI_MODEL=gemini/gemini-3.1-flash-lite

# ── IoT Device Authentication ──────────────────────────────────
# API key used by IoT camera devices to authenticate uploads
DEVICE_API_KEY=gm-device-key

# ── Convex User Environment Variables ──────────────────────────
# These must be set via `npx convex env set`.
# Convex self-hosted does NOT pass through env vars to action runtimes

# Auto-created on deploy via `npx convex run seed:admin`
# npx convex env set ADMIN_EMAIL admin@example.com
# npx convex env set ADMIN_PASSWORD gm-admin-pw
ADMIN_EMAIL=admin@growmate.bond
ADMIN_PASSWORD=gm-admin-pw

# Required by @convex-dev/auth for JWT token signing (PKCS#8 PEM format).
#   Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
#   Set:      npx convex env set JWT_PRIVATE_KEY --from-file key.pem
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMI...qo=\n-----END PRIVATE KEY-----

# Public JWKS for JWT token verification — generated from JWT_PRIVATE_KEY.
#   Generate: node -e "const {exportJWK,importPKCS8}=require('jose'); ...
#   Set:      npx convex env set JWKS '<generated-json>'
JWKS={"keys":[{"use":"sig","e":"AQAB","kty":"RSA","n":"..."}]}

# Seed functions also need these for S3 upload:
# npx convex env set MINIO_ENDPOINT <endpoint>
# npx convex env set MINIO_ACCESS_KEY <key>
# npx convex env set MINIO_SECRET_KEY <secret>
# npx convex env set MINIO_BUCKET_IMAGE <bucket>
