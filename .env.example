# ── Convex ──────────────────────────────────────────────────────
# Public URL used by the browser to connect to Convex
NUXT_PUBLIC_CONVEX_URL=https://convex.growmate.bond

# Origin URLs for Convex backend (internal API communication)
CONVEX_CLOUD_ORIGIN=https://convex.growmate.bond
CONVEX_SITE_ORIGIN=https://convex.growmate.bond
CONVEX_SITE_URL=https://convex.growmate.bond
CONVEX_SELF_HOSTED_URL=https://convex.growmate.bond

# Admin key for deploying functions (used with `npx convex deploy`)
#   Format: <INSTANCE_NAME>|<hex> (generated by backend via ./generate_admin_key.sh)
#   NOTE: Cannot be set arbitrarily — must be generated by the Convex backend
#         from INSTANCE_SECRET. Once generated, set it here to persist across restarts.
CONVEX_SELF_HOSTED_ADMIN_KEY=gm-convex-adm

# Convex instance identity — name + secret
#   INSTANCE_SECRET must be a hex string (generate: openssl rand -hex 32)
CONVEX_INSTANCE_NAME=growmate
CONVEX_INSTANCE_SECRET=gm-convex-sec

# ── MinIO / S3 Storage ─────────────────────────────────────────
# Public URL for browser-accessible image URLs (points to MinIO root)
NUXT_PUBLIC_MINIO_BASE_URL=https://storage.growmate.bond

# Bucket name for plant images (must match on both client and server)
NUXT_PUBLIC_MINIO_BUCKET_IMAGE=images
MINIO_BUCKET_IMAGE=images

# MinIO root credentials — must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD on the container
MINIO_ACCESS_KEY=gm-minio-acc
MINIO_SECRET_KEY=gm-minio-sec

# ── OpenAI / AI (Gemini via OpenAI-compatible endpoint) ────────
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=AIza************************HTs8
OPENAI_MODEL=gemini-flash-latest

# ── IoT Device Authentication ──────────────────────────────────
# API key used by IoT camera devices to authenticate uploads
DEVICE_API_KEY=gm-device-key

# ── Default Admin Account ──────────────────────────────────────
# Auto-created on deploy via `npx convex run seedAdmin:ensureAdmin`
# Both must be set on the Convex backend container (convex: service in compose)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=gm-admin-pw
