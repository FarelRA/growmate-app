{
  "name": "growmate-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:seed:admin": "convex run seed:admin",
    "convex:seed:plants": "convex run seed:plants",
    "convex:seed:products": "convex run seed:products",
    "convex:seed:blog": "convex run seed:blog",
    "convex:seed:all": "convex run seed:admin && convex run seed:plants && convex run seed:products && convex run seed:blog",
    "postinstall": "nuxt prepare",
    "build": "nuxt build",
    "preview": "nuxt preview --host",
    "typecheck": "nuxt typecheck",
    "typecheck:convex": "convex typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli app/ convex/ server/ tests/ stores/ components/",
    "check": "run-s typecheck typecheck:convex lint test build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@convex-dev/auth": "^0.0.94",
    "@convex-vue/core": "^0.0.4",
    "convex": "^1.41.0",
    "isomorphic-dompurify": "^4.1.0",
    "marked": "^18.0.5",
    "nuxt": "^4.4.8",
    "openai": "^6.44.0",
    "sharp": "^0.35.2",
    "vue": "^3.5.38",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/ui": "^4.1.9",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.70.0",
    "eslint-plugin-vue": "~10.9.2",
    "happy-dom": "^20.10.6",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.70.0",
    "prettier": "3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  },
  "overrides": {
    "vue-router": "5.1.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
